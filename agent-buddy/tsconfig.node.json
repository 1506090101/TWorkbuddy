{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "./out/tsc-node",
    "types": ["node"],
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"]
    }
  },
  "include": [
    "main/**/*.ts",
    "preload/**/*.ts",
    "shared/**/*.ts",
    "electron.vite.config.ts"
  ]
}
